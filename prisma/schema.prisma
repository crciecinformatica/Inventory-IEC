generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuid_ossp(map: "uuid-ossp")]
}

model usuarios {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome              String
  codigo_pessoa     String?
  email             String              @unique
  senha_hash        String
  perfil            String?             @default("viewer")
  ativo             Boolean?            @default(true)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  forum_comentarios forum_comentarios[]
  forum_reacoes     forum_reacoes[]
  forum_topicos     forum_topicos[]
  forum_arquivos    forum_arquivos[]
  forum_pastas      forum_pastas[]
  forum_avaliacoes  forum_topico_avaliacoes[]
  checklists_criados checklists_validacao[] @relation("ChecklistCriadoPor")
  checklist_solicitacoes_assumidas checklists_validacao_solicitacoes[] @relation("ChecklistSolicitacaoAssumidaPor")
  checklist_solicitacoes_revisadas checklists_validacao_solicitacoes[] @relation("ChecklistSolicitacaoRevisadaPor")
  checklist_itens_preenchidos checklists_validacao_itens[] @relation("ChecklistItemPreenchidoPor")
  checklist_itens_revisados checklists_validacao_itens[] @relation("ChecklistItemRevisadoPor")
  checklist_racks_respostas checklists_validacao_racks_respostas[] @relation("ChecklistRackPreenchidoPor")
  monitores_criados monitores[] @relation("MonitorCriadoPor")
  alocacoes_monitores_criadas alocacoes_monitores[] @relation("AlocacaoMonitorCriadaPor")

  @@index([codigo_pessoa], map: "idx_usuarios_codigo_pessoa")
}

model solicitacoes_usuarios {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome            String
  codigo_pessoa   String
  email           String
  senha_hash      String
  status          String    @default("pendente")
  observacao      String?
  usuario_id      String?   @db.Uuid
  aprovado_por_id String?   @db.Uuid
  aprovado_por    String?
  aprovado_em     DateTime? @db.Timestamptz(6)
  rejeitado_por_id String?  @db.Uuid
  rejeitado_por   String?
  rejeitado_em    DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([status], map: "idx_solicitacoes_usuarios_status")
  @@index([email], map: "idx_solicitacoes_usuarios_email")
  @@index([codigo_pessoa], map: "idx_solicitacoes_usuarios_codigo_pessoa")
}

model setores {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome                  String          @unique
  created_at            DateTime?       @default(now()) @db.Timestamptz(6)
  ativo                 Boolean         @default(true)
  descricao             String?
  aparelhos             aparelhos[]
  colaboradores         colaboradores[]
  impressoras           impressoras[]
  maquinas              maquinas[]
  notebooks_emprestados notebooks[]     @relation("EmprestimoSetor")
  notebooks             notebooks[]
  racks                 racks[]
  ramais                ramais[]
  checklist_solicitacoes checklists_validacao_solicitacoes[]
  alocacoes_monitores   alocacoes_monitores[]

  @@index([ativo], map: "idx_setores_ativo")
  @@index([nome], map: "idx_setores_nome")
}

model localidades {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome          String          @unique
  ativo         Boolean         @default(true)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  aparelhos     aparelhos[]
  colaboradores colaboradores[]
  impressoras   impressoras[]
  maquinas      maquinas[]
  notebooks     notebooks[]
  racks         racks[]
  ramais        ramais[]
  checklists_validacao checklists_validacao[]

  @@index([ativo], map: "idx_localidades_ativo")
  @@index([nome], map: "idx_localidades_nome")
}

model colaboradores {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo                Int?
  nome                  String
  status                status_colaborador    @default(Ativo)
  created_at            DateTime?             @default(now()) @db.Timestamptz(6)
  localidade_id         String?               @db.Uuid
  setor_id              String?               @db.Uuid
  alocacoes_aparelhos   alocacoes_aparelhos[]
  alocacoes_maquinas    alocacoes_maquinas[]
  alocacoes_notebooks   alocacoes_notebooks[]
  alocacoes_ramais      alocacoes_ramais[]
  localidade_rel        localidades?          @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel             setores?              @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  movimentacoes         movimentacoes[]
  notebooks_emprestados notebooks[]           @relation("EmprestimoColaborador")

  @@index([nome], map: "idx_colaboradores_nome")
  @@index([localidade_id], map: "idx_colaboradores_localidade_id")
}

model maquinas {
  id                 String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome_host          String?
  identificador      String?
  fabricante         String?
  modelo             String?
  categoria          categoria_equipamento?
  tipo               String?
  processador        String?
  memoria_ram        String?
  armazenamento      String?
  endereco_ip        String?
  localizacao        String?
  patrimonio_cpu     String?
  patrimonio_monitor String?
  data_revisao       DateTime?              @db.Date
  created_at         DateTime?              @default(now()) @db.Timestamptz(6)
  localidade_id      String?                @db.Uuid
  setor_id           String?                @db.Uuid
  alocacoes          alocacoes_maquinas[]
  localidade_rel     localidades?           @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel          setores?               @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  solicitacoes_snow_itens solicitacoes_snow_itens[]
  checklist_ultima_id String? @db.Uuid
  checklist_tecnico_id String? @db.Uuid
  checklist_revisor_id String? @db.Uuid
  checklist_revisado_em DateTime? @db.Timestamptz(6)
  alocacoes_monitores alocacoes_monitores[]

  @@index([identificador], map: "idx_maquinas_identificador")
  @@index([localidade_id], map: "idx_maquinas_localidade_id")
}

model notebooks {
  id                        String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  modelo                    String?
  fabricante                String?
  categoria                 categoria_equipamento?
  processador               String?
  memoria                   String?
  armazenamento             String?
  numero_patrimonio         String?
  created_at                DateTime?              @default(now()) @db.Timestamptz(6)
  localidade_id             String?                @db.Uuid
  data_revisao              DateTime?              @db.Date
  emprestado                Boolean                @default(false)
  emprestado_colaborador_id String?                @db.Uuid
  emprestado_desde          DateTime?              @db.Date
  emprestado_obs            String?
  emprestado_setor_id       String?                @db.Uuid
  setor_id                  String?                @db.Uuid
  alocacoes                 alocacoes_notebooks[]
  emprestado_colaborador    colaboradores?         @relation("EmprestimoColaborador", fields: [emprestado_colaborador_id], references: [id], onUpdate: NoAction)
  emprestado_setor          setores?               @relation("EmprestimoSetor", fields: [emprestado_setor_id], references: [id], onUpdate: NoAction)
  localidade_rel            localidades?           @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel                 setores?               @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  checklist_ultima_id       String?                @db.Uuid
  checklist_tecnico_id      String?                @db.Uuid
  checklist_revisor_id      String?                @db.Uuid
  checklist_revisado_em     DateTime?              @db.Timestamptz(6)

  @@index([emprestado_colaborador_id], map: "idx_notebooks_emprestado_colab")
  @@index([localidade_id], map: "idx_notebooks_localidade_id")
}

model aparelhos {
  id             String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  modelo         String?
  tipo           Int?
  chip           Boolean?              @default(false)
  endereco_ip    String?
  endereco_mac   String?
  status         Boolean?              @default(true)
  created_at     DateTime?             @default(now()) @db.Timestamptz(6)
  localidade_id  String?               @db.Uuid
  setor_id       String?               @db.Uuid
  alocacoes      alocacoes_aparelhos[]
  localidade_rel localidades?          @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel      setores?              @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  checklist_ultima_id   String?        @db.Uuid
  checklist_tecnico_id  String?        @db.Uuid
  checklist_revisor_id  String?        @db.Uuid
  checklist_revisado_em DateTime?      @db.Timestamptz(6)

  @@index([localidade_id], map: "idx_aparelhos_localidade_id")
}

model impressoras {
  id                 String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome_host          String?
  fabricante         String?
  modelo             String?
  numero_serie       String?
  endereco_ip        String?
  localidade         String?
  andar              String?
  servidor_impressao String?
  identificador_selb String?
  tipo_usuario       String?
  revisao            DateTime?    @db.Timestamptz(6)
  status             Boolean?     @default(true)
  created_at         DateTime?    @default(now()) @db.Timestamptz(6)
  localidade_id      String?      @db.Uuid
  setor_id           String?      @db.Uuid
  localidade_rel     localidades? @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel          setores?     @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  checklist_ultima_id String? @db.Uuid
  checklist_tecnico_id String? @db.Uuid
  checklist_revisor_id String? @db.Uuid
  checklist_revisado_em DateTime? @db.Timestamptz(6)

  @@index([localidade_id], map: "idx_impressoras_localidade_id")
}

model ramais {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  numero_ramal        String?
  prefixo_telefonico  String?
  disponibilidade     String?
  fila                Boolean?           @default(false)
  contemplacao        Boolean?           @default(false)
  status_contemplacao Int?
  senha_acesso        String?
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  localidade_id       String?            @db.Uuid
  password            String?
  setor_id            String?            @db.Uuid
  alocacoes           alocacoes_ramais[]
  localidade_rel      localidades?       @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel           setores?           @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  checklist_ultima_id String? @db.Uuid
  checklist_tecnico_id String? @db.Uuid
  checklist_revisor_id String? @db.Uuid
  checklist_revisado_em DateTime? @db.Timestamptz(6)

  @@index([localidade_id], map: "idx_ramais_localidade_id")
}

model racks {
  id                      String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome_switch             String?
  marca_switch            String?
  localizacao             String?
  numero_patrimonio       String?
  quantidade_portas       Int?
  portas_em_uso           Int?
  portas_livres           Int?
  portas_academicas       String?
  portas_vlan_impressoras String?
  created_at              DateTime?    @default(now()) @db.Timestamptz(6)
  localidade_id           String?      @db.Uuid
  setor_id                String?      @db.Uuid
  localidade_rel          localidades? @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  setor_rel               setores?     @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  checklist_ultima_id String? @db.Uuid
  checklist_tecnico_id String? @db.Uuid
  checklist_revisor_id String? @db.Uuid
  checklist_validado_em DateTime? @db.Timestamptz(6)
  checklist_revisado_em DateTime? @db.Timestamptz(6)
  checklist_solicitacoes checklists_validacao_solicitacoes[]
  checklist_rack_respostas checklists_validacao_racks_respostas[]

  @@index([localidade_id], map: "idx_racks_localidade_id")
}

model alocacoes_maquinas {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  colaborador_id String?        @db.Uuid
  maquina_id     String?        @db.Uuid
  data_inicio    DateTime?      @db.Date
  data_fim       DateTime?      @db.Date
  tipo_uso       Int?
  ativo          Boolean?       @default(true)
  created_at     DateTime?      @default(now()) @db.Timestamptz(6)
  colaborador    colaboradores? @relation(fields: [colaborador_id], references: [id], onUpdate: NoAction)
  maquina        maquinas?      @relation(fields: [maquina_id], references: [id], onUpdate: NoAction)

  @@index([colaborador_id], map: "idx_alocacoes_maquinas_colaborador")
  @@index([maquina_id], map: "idx_alocacoes_maquinas_maquina")
}

model alocacoes_notebooks {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  colaborador_id  String?        @db.Uuid
  notebook_id     String?        @db.Uuid
  data_inicio     DateTime?      @db.Date
  data_fim        DateTime?      @db.Date
  motivo_alocacao String?
  tipo_posse      Int?
  ativo           Boolean?       @default(true)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  colaborador     colaboradores? @relation(fields: [colaborador_id], references: [id], onUpdate: NoAction)
  notebook        notebooks?     @relation(fields: [notebook_id], references: [id], onUpdate: NoAction)

  @@index([colaborador_id], map: "idx_alocacoes_notebooks_colaborador")
}

model alocacoes_aparelhos {
  id                 String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  colaborador_id     String?        @db.Uuid
  aparelho_id        String?        @db.Uuid
  data_inicio        DateTime?      @db.Date
  data_fim           DateTime?      @db.Date
  descricao_alocacao String?
  motivo_alocacao    String?
  tipo_uso           Int?
  observacoes        String?
  ativo              Boolean?       @default(true)
  created_at         DateTime?      @default(now()) @db.Timestamptz(6)
  aparelho           aparelhos?     @relation(fields: [aparelho_id], references: [id], onUpdate: NoAction)
  colaborador        colaboradores? @relation(fields: [colaborador_id], references: [id], onUpdate: NoAction)

  @@index([colaborador_id], map: "idx_alocacoes_aparelhos_colaborador")
}

model alocacoes_ramais {
  id              String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  colaborador_id  String?        @db.Uuid
  ramal_id        String?        @db.Uuid
  data_inicio     DateTime?      @db.Date
  data_fim        DateTime?      @db.Date
  tipo_base       Int?
  canal_adicional String?
  whatsapp        Boolean?       @default(false)
  ativo           Boolean?       @default(true)
  created_at      DateTime?      @default(now()) @db.Timestamptz(6)
  colaborador     colaboradores? @relation(fields: [colaborador_id], references: [id], onUpdate: NoAction)
  ramal           ramais?        @relation(fields: [ramal_id], references: [id], onUpdate: NoAction)

  @@index([colaborador_id], map: "idx_alocacoes_ramais_colaborador")
}

model checklists_validacao {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nome           String
  localidade_id  String    @db.Uuid
  incluir_racks  Boolean   @default(false)
  status         String    @default("aberto")
  data_inicio    DateTime? @db.Date
  data_fim       DateTime? @db.Date
  criado_por     String?   @db.Uuid
  criado_em      DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em  DateTime? @default(now()) @db.Timestamptz(6)
  localidade     localidades @relation(fields: [localidade_id], references: [id], onUpdate: NoAction)
  criador        usuarios? @relation("ChecklistCriadoPor", fields: [criado_por], references: [id], onUpdate: NoAction)
  solicitacoes   checklists_validacao_solicitacoes[]

  @@index([localidade_id], map: "idx_checklists_validacao_localidade")
  @@index([status], map: "idx_checklists_validacao_status")
  @@index([criado_em(sort: Desc)], map: "idx_checklists_validacao_criado_em")
}

model checklists_validacao_solicitacoes {
  id                      String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  checklist_validacao_id  String    @db.Uuid
  tipo_solicitacao        String
  setor_id                String?   @db.Uuid
  rack_id                 String?   @db.Uuid
  restringir_impressoras  Boolean   @default(false)
  impressora_ids          String[]  @default([]) @db.Uuid
  itens_escopo            String[]  @default([])
  status                  String    @default("aberta")
  assumido_por            String?   @db.Uuid
  assumido_em             DateTime? @db.Timestamptz(6)
  finalizado_em           DateTime? @db.Timestamptz(6)
  revisado_por            String?   @db.Uuid
  revisado_em             DateTime? @db.Timestamptz(6)
  status_revisao          String    @default("pendente")
  planner_task_id         String?
  planner_status          String    @default("pendente")
  planner_atualizado_em   DateTime? @db.Timestamptz(6)
  csc_numero              String?
  csc_criado_em           DateTime? @db.Timestamptz(6)
  csc_atualizado_em       DateTime? @db.Timestamptz(6)
  link_inventario         String?
  comentarios             Json?     @default("[]")
  criado_em               DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em           DateTime? @default(now()) @db.Timestamptz(6)
  checklist               checklists_validacao @relation(fields: [checklist_validacao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  setor                   setores? @relation(fields: [setor_id], references: [id], onUpdate: NoAction)
  rack                    racks? @relation(fields: [rack_id], references: [id], onUpdate: NoAction)
  tecnico                 usuarios? @relation("ChecklistSolicitacaoAssumidaPor", fields: [assumido_por], references: [id], onUpdate: NoAction)
  revisor                 usuarios? @relation("ChecklistSolicitacaoRevisadaPor", fields: [revisado_por], references: [id], onUpdate: NoAction)
  itens                   checklists_validacao_itens[]
  diffs                   checklists_validacao_diffs[]
  rack_resposta           checklists_validacao_racks_respostas?

  @@index([checklist_validacao_id], map: "idx_checklist_solicitacoes_checklist")
  @@index([status], map: "idx_checklist_solicitacoes_status")
  @@index([planner_status], map: "idx_checklist_solicitacoes_planner_status")
}

model checklists_validacao_itens {
  id                                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  checklist_validacao_solicitacao_id  String    @db.Uuid
  tipo_item                           String
  referencia_id                       String?   @db.Uuid
  identificador_informado             String?
  dados_informados_json               Json?
  status_revisao                      String    @default("pendente")
  preenchido_por                      String?   @db.Uuid
  preenchido_em                       DateTime? @db.Timestamptz(6)
  revisado_por                        String?   @db.Uuid
  revisado_em                         DateTime? @db.Timestamptz(6)
  criado_em                           DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em                       DateTime? @default(now()) @db.Timestamptz(6)
  solicitacao                         checklists_validacao_solicitacoes @relation(fields: [checklist_validacao_solicitacao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  preenchido_usuario                  usuarios? @relation("ChecklistItemPreenchidoPor", fields: [preenchido_por], references: [id], onUpdate: NoAction)
  revisado_usuario                    usuarios? @relation("ChecklistItemRevisadoPor", fields: [revisado_por], references: [id], onUpdate: NoAction)
  diffs                               checklists_validacao_diffs[]

  @@index([checklist_validacao_solicitacao_id], map: "idx_checklist_itens_solicitacao")
  @@index([tipo_item], map: "idx_checklist_itens_tipo")
  @@index([referencia_id], map: "idx_checklist_itens_referencia")
}

model checklists_validacao_diffs {
  id                                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  checklist_validacao_item_id         String    @db.Uuid
  checklist_validacao_solicitacao_id  String    @db.Uuid
  campo                               String
  valor_atual                         Json?
  valor_informado                     Json?
  tipo_diff                           String
  status_revisao                      String    @default("pendente")
  criado_em                           DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em                       DateTime? @default(now()) @db.Timestamptz(6)
  item                                checklists_validacao_itens @relation(fields: [checklist_validacao_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  solicitacao                         checklists_validacao_solicitacoes @relation(fields: [checklist_validacao_solicitacao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([checklist_validacao_item_id], map: "idx_checklist_diffs_item")
  @@index([checklist_validacao_solicitacao_id], map: "idx_checklist_diffs_solicitacao")
  @@index([status_revisao], map: "idx_checklist_diffs_status")
}

model checklists_validacao_racks_respostas {
  id                                  String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  checklist_validacao_solicitacao_id  String    @unique @db.Uuid
  rack_id                             String    @db.Uuid
  dados_informados_json               Json?
  observacoes                         String?
  preenchido_por                      String?   @db.Uuid
  preenchido_em                       DateTime? @db.Timestamptz(6)
  criado_em                           DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em                       DateTime? @default(now()) @db.Timestamptz(6)
  solicitacao                         checklists_validacao_solicitacoes @relation(fields: [checklist_validacao_solicitacao_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rack                                racks @relation(fields: [rack_id], references: [id], onUpdate: NoAction)
  preenchido_usuario                  usuarios? @relation("ChecklistRackPreenchidoPor", fields: [preenchido_por], references: [id], onUpdate: NoAction)

  @@index([rack_id], map: "idx_checklist_rack_respostas_rack")
}

model monitores {
  id                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo_interno        String?   @unique
  patrimonio            String?   @unique
  serial                String?
  marca                 String?
  modelo                String?
  status                String    @default("ativo")
  criado_via_checklist  Boolean   @default(false)
  criado_por            String?   @db.Uuid
  criado_em             DateTime? @default(now()) @db.Timestamptz(6)
  atualizado_em         DateTime? @default(now()) @db.Timestamptz(6)
  checklist_ultima_id   String?   @db.Uuid
  checklist_tecnico_id  String?   @db.Uuid
  checklist_revisor_id  String?   @db.Uuid
  checklist_revisado_em DateTime? @db.Timestamptz(6)
  criador               usuarios? @relation("MonitorCriadoPor", fields: [criado_por], references: [id], onUpdate: NoAction)
  alocacoes             alocacoes_monitores[]

  @@index([serial], map: "idx_monitores_serial")
  @@index([status], map: "idx_monitores_status")
